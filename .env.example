# Copy to .env (git-ignored). The Makefile loads it for make run / make migrate.
# Keep comments on their own lines: make and compose treat trailing text differently.

# development | production
ENV=development
# Cloud Run sets PORT instead; HTTP_ADDR wins if both are set.
HTTP_ADDR=:8080
# Cloud Run allows 10s between SIGTERM and SIGKILL, so stay below that.
HTTP_SHUTDOWN_TIMEOUT=8s
# How long /readyz reports 503 before the listener closes.
HTTP_DRAIN_DELAY=0s

DATABASE_URL=postgres://loadout:loadout@localhost:5432/loadout?sslmode=disable
DATABASE_MAX_CONNS=10
# Postgres cancels any single statement that runs longer than this (0 = no limit).
# `loadout migrate` always runs without a limit.
DATABASE_STATEMENT_TIMEOUT=5s

# How long running background jobs get to finish after SIGTERM before they are cancelled
# (and retried later). The hard stop after it adds up to 1s, so stay below Cloud Run's 10s.
JOBS_STOP_TIMEOUT=7s

# Supplier API that `loadout sync` pulls from: mock-vali locally (`make mock-vali`).
# Defaults to http://localhost:8081 in development; required in production.
VALI_URL=http://localhost:8081

# Encrypts admins' TOTP secrets: 32 bytes in base64 (openssl rand -base64 32). Has a fixed
# default in development; required in production, from Secret Manager.
# TOTP_KEY=
# true lets admins use the admin API without the TOTP code, for local work. Refused in production.
AUTH_SKIP_TOTP=false

# The storefront's public origin, for links in emails. Defaults to the web dev server
# (http://localhost:3000) in development; required in production.
# SITE_URL=

# Outgoing email. Development defaults to Mailpit (make up; inbox at http://localhost:8025).
# All three are required in production, with the provider's SMTP login.
# SMTP_ADDR=localhost:1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Loadout <noreply@loadout.localhost>

# debug | info | warn | error
LOG_LEVEL=info
# text | json (defaults to json when ENV=production)
LOG_FORMAT=text

# Web app (web/): where the TanStack Start server reaches the API (SSR and the dev proxy).
API_INTERNAL_URL=http://localhost:8080

# Docker Compose host ports, if the defaults clash with something else on your machine.
# If you change POSTGRES_HOST_PORT, change DATABASE_URL to match.
# POSTGRES_HOST_PORT=5432
# MAILPIT_UI_HOST_PORT=8025
# MAILPIT_SMTP_HOST_PORT=1025
# RIVERUI_HOST_PORT=8082
