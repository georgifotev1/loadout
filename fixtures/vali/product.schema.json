{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loadout.bg/schemas/mock-vali/product.json",
  "title": "mock-vali raw product",
  "description": "One product as mock-vali serves it. Public fields are copied from vali.bg as-is; dealer fields are invented. ASSUMPTION: the real Vali dealer API shape is unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sku", "brand", "name", "category_path", "url", "images", "specs",
    "dealer_price_cents", "rrp_cents", "currency", "stock", "updated_at", "_mock"
  ],
  "properties": {
    "sku": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "manufacturer_code": { "type": "string", "minLength": 1 },
    "ean": { "type": "string", "pattern": "^[0-9]{8,14}$" },
    "brand": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "category_path": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "url": { "type": "string", "pattern": "^https://www\\.vali\\.bg/[a-z0-9-]+$" },
    "warranty": { "type": "string", "minLength": 1 },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "specs": {
      "description": "Raw key/value rows, not normalized. Empty strings are real (vali.bg shows empty rows).",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "dealer_price_cents": { "type": "integer", "minimum": 1 },
    "rrp_cents": { "type": "integer", "minimum": 1 },
    "currency": { "const": "EUR" },
    "stock": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "_mock": { "type": "string", "minLength": 1 }
  }
}
